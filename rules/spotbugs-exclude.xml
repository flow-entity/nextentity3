<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/4.8.6"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/4.8.6
                        https://raw.githubusercontent.com/spotbugs/spotbugs/release-4.8.6/spotbugs/etc/findbugsfilter.xsd">

    <!-- Spec 节点、Tuple、Slice 等不可变数据载体：内部集合不复制 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- 不可变数据类天然会返回可变集合，按设计接受 -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- 仓储基类必须在构造器里拒绝「泛型解析不出来」的子类：晚一步失败，空指针会落在
         JpaMeta 的 ConcurrentHashMap 里，栈上看不出是哪个仓库写错了泛型。SpotBugs 的
         CT_CONSTRUCTOR_THROW 针对的是「可终结类在构造期抛异常会留下未初始化对象供 finalizer
         攻击」，而这里 1) 类层次里没有任何 finalize()，2) 异常只来自调用方自己写错的泛型，
         对象在抛出时从未逸出。SpotBugs 给出的修法（把类声明成 final）与本类「供子类继承」
         的设计直接冲突，因此只对这一处放行。 -->
    <Match>
        <Class name="io.github.nextentity.spring.AbstractRepository"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- JDBC 执行器/写入器：SQL 一律来自自家 JdbcCompiler 生成的 SqlStatement.sql()（表名/列名由
         JdbcMeta 反射注解得到，值与 LIMIT/OFFSET 全走 PreparedStatement 参数绑定），不存在用户拼接；
         SpotBugs 的「非常量 SQL」在这条链路上是误报，因此只按方法放行（不按类、更不按规则全仓放行，
         免得这两类以后真出现拼接 SQL 时静默通过）。方法名取自 spotbugsXml 里 bugInstance 的 method 属性。
         这是静态分析排除，不是 @Disabled，无 expires。 -->
    <Match>
        <Class name="io.github.nextentity.jdbc.exec.JdbcExecutor"/>
        <Method name="read"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>
    <Match>
        <Class name="io.github.nextentity.jdbc.exec.JdbcPersistExecutor"/>
        <Method name="insertGenerated"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>
    <Match>
        <Class name="io.github.nextentity.jdbc.exec.JdbcPersistExecutor"/>
        <Method name="insertBatch"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>
    <Match>
        <Class name="io.github.nextentity.jdbc.exec.JdbcPersistExecutor"/>
        <Method name="executeUpdate"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>

</FindBugsFilter>
