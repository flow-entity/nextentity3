<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>nextentity-spring</artifactId>
    <name>nextentity-spring</name>
    <description>Spring Boot 自动配置与事务桥接</description>
    <properties>
        <!-- 发布集：本模块与 nextentity-{api,core,jpa,jdbc,spring,bom} 一起发到 Central，
             覆盖根 pom 的默认 true（默认不发布），仅 -Ppublish 生效。 -->
        <central.publishing.skipPublishing>false</central.publishing.skipPublishing>
        <maven.source.skip>false</maven.source.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <gpg.skip>false</gpg.skip>
        <flatten.skip>false</flatten.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          自动配置门禁用例：`ApplicationContextRunner` 起一个只含本自动配置的上下文。
          注意这里**没有** mockito：`NextEntityAutoConfigurationTest` 明确改用真 Hibernate + H2
          建 EMF、用 `SharedEntityManagerCreator` 建共享 EM 代理，因为 mock 的 EMF 拿不到真元模型，
          断言只能停在「bean 个数」。曾经声明的 `mockito-core` 全仓零引用（`mock(` / `when(` 零命中），
          留着等于给「顺手 mock 一下 EntityManager」留了个邀请——按红线「mock 只许证形状」，
          它一旦被用在一致性基类里，覆盖率/变异分数/用例数会全部照绿而正确性证据已经蒸发。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 真实接线用例：真 Hibernate + H2 + 事务绑定的共享 EntityManager 代理（不用 mock 证明语义） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              变异测试（PIT）：本模块只有两个类，但 `AbstractRepository` 是纯委派、`NextEntityAutoConfiguration`
              是纯条件装配，两处的变异（漏委托一个方法、条件装配漏一个 `@ConditionalOnMissingBean`）
              都是「编译过、测试假绿」的典型形态，必须用变异分数兜住。
              阈值 95：与 api/core/jpa 一致，等价变异杀不死，阈值只挡真回退。
              见 docs/DESIGN.md §5「变异测试」。
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>io.github.nextentity.spring.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.github.nextentity.spring.*</param>
                    </targetTests>
                    <failWhenNoMutations>true</failWhenNoMutations>
                    <mutationThreshold>95</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
