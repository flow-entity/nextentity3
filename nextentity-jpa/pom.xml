<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>nextentity-jpa</artifactId>
    <name>nextentity-jpa</name>
    <description>Criteria 渲染与 JPA 执行</description>
    <properties>
        <!-- 发布集：本模块与 nextentity-{api,core,jpa,jdbc,spring,bom} 一起发到 Central，
             覆盖根 pom 的默认 true（默认不发布），仅 -Ppublish 生效。 -->
        <central.publishing.skipPublishing>false</central.publishing.skipPublishing>
        <maven.source.skip>false</maven.source.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <gpg.skip>false</gpg.skip>
        <flatten.skip>false</flatten.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- 测试底座：真实 Hibernate + H2，端到端验证 Criteria 渲染结果（版本由根 pom 托管） -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 依赖方向门禁：jpa 不得依赖 Spring -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-jpa-spring-free</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                    </excludes>
                                    <message>jpa 模块只负责 Criteria 渲染与执行；Spring 装配属于 spring 模块</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              变异测试：覆盖**整个模块**（渲染、谓词、操作数、执行器、元模型），不绑生命周期。命令：
              `mvn -pl nextentity-jpa pitest:mutationCoverage`
              全模块实测约 26s / 125 个变异，成本可以接受，因此不再只挑 compile 包。
              阈值 95：已论证的等价变异（JpaPersistExecutor 的 detach 分支，见该文件 javadoc）
              杀不死，理论满分是 123/125，留出余量只用来挡真回退。
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>io.github.nextentity.jpa.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.github.nextentity.jpa.*</param>
                    </targetTests>
                    <mutationThreshold>95</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
