<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextentity-bom</artifactId>
    <packaging>pom</packaging>
    <name>nextentity-bom</name>
    <description>依赖版本对齐</description>
    <properties>
        <!-- 发布集：本模块与 nextentity-{api,core,jpa,jdbc,spring,bom} 一起发到 Central，
             覆盖根 pom 的默认 true（默认不发布），仅 -Ppublish 生效。 -->
        <central.publishing.skipPublishing>false</central.publishing.skipPublishing>
        <maven.source.skip>false</maven.source.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <gpg.skip>false</gpg.skip>
        <flatten.skip>false</flatten.skip>
        <!-- BOM 要保留 dependencyManagement（ossrh 模式会剥掉它） -->
        <flatten.mode>bom</flatten.mode>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
