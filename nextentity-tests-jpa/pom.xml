<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextentity-tests-jpa</artifactId>
    <name>nextentity-tests-jpa</name>
    <description>JPA 集成测试：SQL 快照 + 真实方言</description>

    <dependencyManagement>
        <dependencies>
            <!-- 底座版本先钉，再 import Boot BOM：Maven 里「先声明者赢」，import 会被就地展开并
                 压过父 pom 继承来的条目。这四条框定的是本模块跑语料用的引擎与测试框架，
                 必须与 nextentity-jpa / nextentity-core 的 H2 通道保持同一版本，否则「同一套
                 语料换后端也对拍得上」这个前提就不成立（Boot BOM 会把它们分别抬到
                 h2 2.4.x / JUnit 6 / Testcontainers 2.x）。 -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mysql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <!-- JUnit 全家（jupiter + platform + vintage）一律从根 pom 的 junit-bom 取。这条必须排在
                 spring-boot-dependencies 之前：Boot 4.0.0 自带 junit-bom 6.0.1，两个 import 竞争时
                 先声明者赢；只钉 junit-jupiter 是不够的——jupiter 会停在 5.11.4，而 platform 仍被
                 Boot 抬到 6.0.1，同一模块里混两套 JUnit 大版本（实测如此，且 540 条照样能跑，
                 属于运气而不是门禁）。 -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring 侧接线用例要真 spring-tx / spring-orm：版本仍由 Spring Boot BOM 统一管理，
                 与 nextentity-spring 模块保持同一套版本，避免两处漂移。 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-testing</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SQL 快照需要真实的 Hibernate（StatementInspector 是 Hibernate 的 SPI）。
             版本对齐 point-mall：Spring Boot 4.0.0 管理 Hibernate 7.1.8.Final。 -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 容器通道要真方言连接：Testcontainers 的 mysql 模块本身不带 JDBC 驱动。
             版本与 nextentity-tests-legacy 的 MySQL 跑法对齐（它已验证 8.0.x）。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring 侧真实接线在**真 MySQL** 上的容器变体：`nextentity-spring` 的
             `NextEntityRealBackendTest` 只跑 H2，事务绑定的共享 EM 代理 + 真方言 + 回滚
             这一组合此前没有任何证据。 -->
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- 对齐 point-mall：Spring Boot 4.0.0 管理的 Hibernate 版本 -->
        <hibernate.version>7.1.8.Final</hibernate.version>
        <!-- 没有 main 字节码，不跑二进制扫描 -->
        <spotbugs.skip>true</spotbugs.skip>
        <!-- 容器通道要跟 Docker 守护进程说同一个 API 版本：Testcontainers 1.20.4 内置的 docker-java
             把请求钉在 1.32，而 Docker 25 起逐步淘汰旧版本（29.x 直接对 1.32 回 400 Bad Request，
             表现为「Could not find a valid Docker environment」）。docker-java 从系统属性
             `api.version` 读这个值，所以由 failsafe 在 fork 出的 JVM 里注入。
             换 Docker 版本时用 -Ddocker.api.version=<版本> 覆盖，不必改 pom。 -->
        <docker.api.version>1.44</docker.api.version>
        <!-- 容器通道的开关：默认宽进（没有 Docker 就跳过），CI 应当传 true 让 L4 不可静默降级。
             语义与理由见 support/MySqlL4Gate.java。 -->
        <nextentity.requireContainer>false</nextentity.requireContainer>
        <!-- JVM 默认时区：时间列的往返断言（`Instant` 不得被时区挪动）只有「墙钟被挪过就会差整小时」
             这个区分力，跑测机器若在 UTC 上，该断言对「按 JVM 时区换算」这类缺陷的区分力归零。
             所以由 surefire/failsafe 在 fork 出的 JVM 上钉死，而不是在用例的 `@BeforeEach` 里设——
             Hibernate 在 `buildSessionFactory()` 时就缓存了默认时区，`@BeforeEach` 晚于它
             （装置由子类字段初始化创建），顺序上等于没钉。
             换时区验证兼容性用 `-Dpinned.timezone=America/New_York` 整通道跑——这个属性同时进
             `-Duser.timezone`（fork 出的 JVM）与 `-Dnextentity.pinnedTimezone`（契约自检的期望），
             两处同源，「换过时区也全绿」才有意义。**不要**用 `-DargLine=...`：jacoco
             `prepare-agent` 会覆盖 `argLine` 属性，且本 pom 已把 `-Duser.timezone` 写进同一个
             `argLine`，后写胜出，改了等于没改。 -->
        <pinned.timezone>Asia/Shanghai</pinned.timezone>
        <!-- 空默认值：`@{argLine}` 是 late-replacement，读的是 jacoco `prepare-agent` 写进
             `argLine` 属性的 agent 参数。属性不存在时 late-replacement 会报错（`-Djacoco.skip=true`
             的跑法就是这种情况），所以先在这里给一个空值。 -->
        <argLine></argLine>
        <!-- 镜像源：直连 registry-1.docker.io 在受限网络下会 EOF，而容器用例是 L4 的唯一载体，
             拉不到镜像等于这层没跑。默认走 docker.xuanyuan.run，换源/换版本用
             -Dnextentity.mysql.image= / -Dnextentity.ryuk.image= 覆盖，不必改 pom。
             ryuk 也要走同一个源：Testcontainers 会另起一个 Ryuk 容器负责回收，它默认从 Docker Hub 拉。 -->
        <nextentity.mysql.image>docker.xuanyuan.run/library/mysql:8.0.18</nextentity.mysql.image>
        <nextentity.ryuk.image>docker.xuanyuan.run/testcontainers/ryuk:0.11.0</nextentity.ryuk.image>
    </properties>

    <build>
        <plugins>
            <!-- 两条通道按类名分流，互不吞并：
                 - surefire（`mvn test` / `verify` 前半程）跑 H2 用例 `*Test`，显式排除 `*IntegrationTest`；
                 - failsafe（`integration-test` + `verify`）只收 `*IntegrationTest`，即需要 Docker 的容器用例。
                 failsafe 默认 includes 是 `**/IT*` / `**/*IT` / `**/*ITCase`，与项目约定的 `*IntegrationTest`
                 命名不匹配，不显式覆盖则容器用例会被 surefire 跑掉、failsafe 一条也收不到。
                 PR 档只要 H2：`-DskipITs`（failsafe 自带属性，只跳容器通道），H2 条数不变。 -->
            <!-- 跨模块合并覆盖率：本模块是唯一同时执行 L2/L3/L4 的地方，只有在这里做
                 `report-aggregate` 才能看到「全部测试合起来还有哪些生产代码行没人跑」。
                 各模块自己的 `report` 只看得到本模块 src/test 的执行数据（模块局部口径），
                 语义套件跑出来的覆盖率进不去——`JpaOperands` 的算术分支就是这样被误判成未覆盖的。
                 产物在 `target/site/jacoco-aggregate/jacoco.xml`。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- `@{argLine}` 必须保留：jacoco 的 agent 参数走这个属性，直接写死会把它覆盖掉。
                         两个 `-D` 必须来自同一个属性，否则契约的自检期望会和 JVM 实际时区分家。 -->
                    <argLine>@{argLine} -Duser.timezone=${pinned.timezone} -Dnextentity.pinnedTimezone=${pinned.timezone}</argLine>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Duser.timezone=${pinned.timezone} -Dnextentity.pinnedTimezone=${pinned.timezone}</argLine>
                    <includes>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                        <nextentity.requireContainer>${nextentity.requireContainer}</nextentity.requireContainer>
                        <nextentity.mysql.image>${nextentity.mysql.image}</nextentity.mysql.image>
                        <!-- Testcontainers 自己的开关：Ryuk 容器镜像（默认 testcontainers/ryuk） -->
                        <ryuk.container.image>${nextentity.ryuk.image}</ryuk.container.image>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <!-- 同一个值的环境变量形态：Testcontainers 对 RYUK 镜像同时认 env 与属性，
                             两条都给，避免只认其中一条的版本差异导致悄悄回落到 Docker Hub -->
                        <TESTCONTAINERS_RYUK_CONTAINER_IMAGE>${nextentity.ryuk.image}</TESTCONTAINERS_RYUK_CONTAINER_IMAGE>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
