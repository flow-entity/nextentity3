<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextentity-tests-jdbc</artifactId>
    <name>nextentity-tests-jdbc</name>
    <description>JDBC 后端测试：H2（surefire）+ 真 MySQL / PostgreSQL / SQL Server 容器（failsafe 三通道）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-jdbc</artifactId>
        </dependency>
        <!-- 一致性/差分基类：只依赖 api + core 接口，测试类只写接线 -->
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-testing</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 容器通道要真方言连接：Testcontainers 的 mysql 模块本身不带 JDBC 驱动。
             版本与 nextentity-tests-jpa 对齐（8.0.x 已实测）。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQL / SQL Server 容器通道：testcontainers 子模块 + 各自 JDBC 驱动（同 MySQL 约定） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mssqlserver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- 没有 main 字节码，不跑二进制扫描 -->
        <spotbugs.skip>true</spotbugs.skip>
        <!-- `docker.api.version` / `nextentity.requireContainer` / 镜像源集中在根 pom：
             容器通道的公共开关一处定义，漏注入的模块会静默降级（见根 pom 注释）。 -->
        <!-- jacoco prepare-agent 写 argLine 属性；`-Djacoco.skip=true` 时属性不存在，
             late-replacement `@{argLine}` 会报错，所以先给空默认值（同 nextentity-tests-jpa）。 -->
        <argLine></argLine>
    </properties>

    <build>
        <plugins>
            <!--
              两条通道按类名分流：surefire 跑 H2 用例 `*Test`，failsafe 只收 `*IntegrationTest`（真 MySQL）。
              failsafe 默认 includes 是 `**/IT*` / `**/*IT` / `**/*ITCase`，与项目约定的 `*IntegrationTest`
              不匹配——不显式覆盖时容器用例会被 surefire 跑掉、failsafe 一条也收不到。
              H2 用例在 MySQL 兼容模式（`MODE=MySQL`）下建库并用的原因：NULL 排序默认值等语义要对齐
              MySQL 这一侧，否则「H2 绿、MySQL 红」要靠容器通道才发现（见 docs/DESIGN.md §5）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- `@{argLine}` 保留：jacoco agent 参数走这个属性，写死会把它覆盖掉 -->
                    <argLine>@{argLine}</argLine>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <includes>
                        <include>**/MySql*IntegrationTest.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                        <nextentity.requireContainer>${nextentity.requireContainer}</nextentity.requireContainer>
                        <nextentity.mysql.image>${nextentity.mysql.image}</nextentity.mysql.image>
                        <!-- Testcontainers 自己的开关：Ryuk 容器镜像（默认 testcontainers/ryuk） -->
                        <ryuk.container.image>${nextentity.ryuk.image}</ryuk.container.image>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <!-- 同一个值的环境变量形态：TESTCONTAINERS 对 Ryuk 镜像同时认 env 与属性，
                             两条都给，避免版本差异只认其中一条导致悄悄回落到 Docker Hub -->
                        <TESTCONTAINERS_RYUK_CONTAINER_IMAGE>${nextentity.ryuk.image}</TESTCONTAINERS_RYUK_CONTAINER_IMAGE>
                    </environmentVariables>
                </configuration>
            </plugin>

            <!-- 跨模块合并覆盖率：jdbc 生产代码的主要执行者在本模块（一致性/差分套件），
                 只有 report-aggregate 才看得到「全部测试合起来」的口径（同 nextentity-tests-jpa）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- PostgreSQL 容器通道：failsafe 类名白名单切到 Postgres*，报告写到独立目录，
             gate-receipt.py 按该目录认 `failsafe:nextentity-tests-jdbc-postgres` 通道。
             `-Dnextentity.requireContainer=true` 在 profile 里固化：方言通道不允许静默降级。 -->
        <profile>
            <id>jdbc-postgres</id>
            <properties>
                <nextentity.requireContainer>true</nextentity.requireContainer>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/failsafe-pg-reports</reportsDirectory>
                            <includes>
                                <include>**/Postgres*IntegrationTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <api.version>${docker.api.version}</api.version>
                                <nextentity.requireContainer>${nextentity.requireContainer}</nextentity.requireContainer>
                                <nextentity.postgres.image>${nextentity.postgres.image}</nextentity.postgres.image>
                                <ryuk.container.image>${nextentity.ryuk.image}</ryuk.container.image>
                            </systemPropertyVariables>
                            <environmentVariables>
                                <TESTCONTAINERS_RYUK_CONTAINER_IMAGE>${nextentity.ryuk.image}</TESTCONTAINERS_RYUK_CONTAINER_IMAGE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- SQL Server 容器通道：同上，类名白名单切到 SqlServer*。 -->
        <profile>
            <id>jdbc-sqlserver</id>
            <properties>
                <nextentity.requireContainer>true</nextentity.requireContainer>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/failsafe-mssql-reports</reportsDirectory>
                            <includes>
                                <include>**/SqlServer*IntegrationTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <api.version>${docker.api.version}</api.version>
                                <nextentity.requireContainer>${nextentity.requireContainer}</nextentity.requireContainer>
                                <nextentity.sqlserver.image>${nextentity.sqlserver.image}</nextentity.sqlserver.image>
                                <ryuk.container.image>${nextentity.ryuk.image}</ryuk.container.image>
                            </systemPropertyVariables>
                            <environmentVariables>
                                <TESTCONTAINERS_RYUK_CONTAINER_IMAGE>${nextentity.ryuk.image}</TESTCONTAINERS_RYUK_CONTAINER_IMAGE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
