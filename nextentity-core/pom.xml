<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextentity-core</artifactId>
    <name>nextentity-core</name>
    <description>Meta / Spec / Compiler / Executor / Repository 接口</description>

    <dependencies>
        <dependency>
            <groupId>io.github.flow-entity</groupId>
            <artifactId>nextentity-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <jacoco.check.skip>false</jacoco.check.skip>
        <!-- 发布集：本模块发到 Central，覆盖根 pom 的默认 true，仅 -Ppublish 生效 -->
        <central.publishing.skipPublishing>false</central.publishing.skipPublishing>
        <maven.source.skip>false</maven.source.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <gpg.skip>false</gpg.skip>
        <flatten.skip>false</flatten.skip>
    </properties>

    <build>
        <plugins>
            <!-- 依赖方向门禁：core 不得依赖 JPA / Hibernate / Spring -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-core-backend-free</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>jakarta.persistence:*</exclude>
                                        <exclude>org.hibernate.orm:*</exclude>
                                        <exclude>org.springframework:*</exclude>
                                    </excludes>
                                    <message>core 只放与后端无关的抽象；JPA/Hibernate/Spring 只能出现在 jpa / spring 模块</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              变异测试：只跑本模块，不绑生命周期。命令：
              `mvn -pl nextentity-core pitest:mutationCoverage`
              阈值 95 的理由见下面内联注释；它不绑生命周期，只在显式执行时才校验。
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>io.github.nextentity.core.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.github.nextentity.core.*</param>
                    </targetTests>
                    <!-- 不设 100：等价变异杀不死，且新代码磨合期会短暂掉分；阈值只用来挡住真回退 -->
                    <mutationThreshold>95</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
