<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.flow-entity</groupId>
    <artifactId>nextentity</artifactId>
    <version>3.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>nextentity</name>
    <description>JPA 之上的小型类型安全查询层</description>

    <url>https://github.com/flow-entity/nextentity3</url>
    <inceptionYear>2024</inceptionYear>

    <!-- Central Portal 在 bundle 校验阶段要求 POM 里带齐 url/licenses/developers/scm，
         缺任何一项都会在 upload 之后才被拒（本地构建照样绿）。这些元素在 `-Ppublish` 时
         由 flatten-maven-plugin 的 ossrh 模式带进部署 POM。 -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>flow-entity</id>
            <name>HuangChengwei</name>
            <email>huang.chengwei@icloud.com</email>
            <url>https://github.com/flow-entity</url>
            <organization>flow-entity</organization>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/flow-entity/nextentity3.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/flow-entity/nextentity3.git</developerConnection>
        <url>https://github.com/flow-entity/nextentity3</url>
        <!-- 与 release.yml 的触发条件 `v*` 一致：tag 名 = v + pom 版本 -->
        <tag>v${project.version}</tag>
    </scm>

    <modules>
        <module>nextentity-api</module>
        <module>nextentity-core</module>
        <module>nextentity-arch</module>
        <module>nextentity-jpa</module>
        <module>nextentity-jdbc</module>
        <module>nextentity-spring</module>
        <module>nextentity-testing</module>
        <module>nextentity-tests-jpa</module>
        <module>nextentity-tests-jdbc</module>
        <module>nextentity-tests-legacy</module>
        <!-- 真实语料：2.2.3 examples 移植，不发布，只作「0 调用点」检验器与真实旅程推演 -->
        <module>nextentity-examples</module>
        <module>nextentity-bom</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 运行时依赖版本 -->
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <spring-boot.version>4.0.0</spring-boot.version>
        <!-- 与 point-mall 实际解析到的 hibernate-core 对齐（mvn -f point-mall dependency:tree -Dincludes=org.hibernate.orm） -->
        <hibernate.version>7.1.8.Final</hibernate.version>

        <!-- 测试依赖版本 -->
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <archunit.version>1.4.1</archunit.version>
        <h2.version>2.3.232</h2.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <postgresql.version>42.7.10</postgresql.version>
        <mssql-jdbc.version>13.2.1.jre11</mssql-jdbc.version>

        <!-- 容器通道的公共开关。放在根 pom 而不是各测试模块里：这套值漏在任何一个模块外，
             那个模块的容器通道就会以「Could not find a valid Docker environment」静默降级
             （`nextentity-tests-legacy` 就这么漏了一整轮，见 CHANGELOG 3.0.0 条目）。 -->
        <!-- 容器通道要跟 Docker 守护进程说同一个 API 版本：Testcontainers 1.20.4 内置的 docker-java
             把请求钉在 1.32，而 Docker 25 起逐步淘汰旧版本（29.x 直接对 1.32 回 400 Bad Request，
             表现为「Could not find a valid Docker environment」，且**所有**策略都被判无效）。
             docker-java 从系统属性 `api.version` 读这个值，所以必须由 surefire/failsafe
             在 fork 出的 JVM 里注入。换 Docker 版本时用 -Ddocker.api.version=<版本> 覆盖。
             **1.44 是 Engine API 版本，不是 Docker 引擎版本号**（1.44 要求 Docker ≥ 25；Docker 24
             及更早只支持到 1.43，会报 `client is newer than server`，同样不可读）。它与「29.8.0」
             这类引擎版本号不是同一量纲，别混用：本机可用性是用 1.44 实测出来的，与引擎版本无关。 -->
        <docker.api.version>1.44</docker.api.version>
        <!-- 容器通道的开关：默认宽进（没有 Docker 就跳过），CI 应当传 true 让容器层不可静默降级。
             语义与理由见 nextentity-tests-jpa 的 support/MySqlL4Gate.java。 -->
        <nextentity.requireContainer>false</nextentity.requireContainer>
        <!-- 镜像源：直连 registry-1.docker.io 在受限网络下会 EOF，而容器用例是 L4 的唯一载体，
             拉不到镜像等于这层没跑。默认走 docker.xuanyuan.run，换源/换版本用 -D 覆盖。
             ryuk 也要走同一个源：Testcontainers 会另起一个 Ryuk 容器负责回收，它默认从 Docker Hub 拉。 -->
        <nextentity.mysql.image>docker.xuanyuan.run/library/mysql:8.0.18</nextentity.mysql.image>
        <nextentity.postgres.image>docker.xuanyuan.run/library/postgres:16</nextentity.postgres.image>
        <nextentity.sqlserver.image>mcr.microsoft.com/mssql/server:2022-latest</nextentity.sqlserver.image>
        <nextentity.ryuk.image>docker.xuanyuan.run/testcontainers/ryuk:0.11.0</nextentity.ryuk.image>

        <!-- 构建插件版本 -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>10.21.4</checkstyle.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <spotbugs-maven-plugin.version>4.10.2.0</spotbugs-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <japicmp-maven-plugin.version>0.23.1</japicmp-maven-plugin.version>
        <pitest-maven.version>1.20.3</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>

        <!-- 发布插件版本（只在 -Ppublish 生效，选版理由见 -Ppublish profile 的注释） -->
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <!-- flatten 模式：普通 jar 模块用 ossrh（保留 Central 必需的 url/licenses/developers/scm），
             nextentity-bom 在自己 pom 里覆盖成 bom（额外保留 dependencyManagement）。 -->
        <flatten.mode>ossrh</flatten.mode>

        <!-- 门禁开关：仅当模块已有实现类时开启覆盖率校验 -->
        <jacoco.check.skip>true</jacoco.check.skip>

        <!-- 发布集开关（-Ppublish 之外无副作用：对应的插件只在 publish profile 里声明）。
             默认全部 true = 不发布：root aggregator、nextentity-arch、nextentity-testing、
             nextentity-tests-* 都靠这个默认值排除；6 个对外模块在自己的 pom 里覆盖成 false。
             默认拒绝而不是默认发布，是为了让「将来新加的模块」不会在没人注意时被发出去。 -->
        <central.publishing.skipPublishing>true</central.publishing.skipPublishing>
        <central.publishing.skipUpload>false</central.publishing.skipUpload>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
        <flatten.skip>true</flatten.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.flow-entity</groupId>
                <artifactId>nextentity-testing</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${jakarta.persistence.version}</version>
            </dependency>

            <!-- Hibernate 只在 jpa/spring 的测试期需要；scope 由使用方声明 -->
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${hibernate.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mysql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mssqlserver</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.microsoft.sqlserver</groupId>
                <artifactId>mssql-jdbc</artifactId>
                <version>${mssql-jdbc.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:deprecation,-processing</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <palantirJavaFormat/>
                            <removeUnusedImports/>
                        </java>
                        <lineEndings>UNIX</lineEndings>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/rules/checkstyle.xml</configLocation>
                        <failOnViolation>true</failOnViolation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        <linkXRef>false</linkXRef>
                        <consoleOutput>true</consoleOutput>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin.version}</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/rules/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <minimumPriority>4</minimumPriority>
                        <failOnViolation>true</failOnViolation>
                        <linkXRef>false</linkXRef>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <threshold>Low</threshold>
                        <failOnError>true</failOnError>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/rules/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                </plugin>
                <!--
                  变异测试（PIT）：刻意不绑生命周期，只在显式 `mvn pitest:mutationCoverage` 时执行。
                  它是「测得够不够」的度量尺，不是每次提交都要跑的关卡——绑进 verify 会让门禁多花几分钟，
                  而结论一周看一次就够。阈值不在这里设：它随各模块的实测基线定在模块 pom 里，
                  见 docs/DESIGN.md §5「度量体系」。
                -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest-maven.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5-plugin.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <outputFormats>
                            <param>HTML</param>
                            <param>XML</param>
                        </outputFormats>
                        <timestampedReports>false</timestampedReports>
                        <threads>4</threads>
                        <failWhenNoMutations>false</failWhenNoMutations>
                        <!--
                          算子集：`DEFAULTS` 只覆盖「改边界 / 改条件 / 改返回值 / 删 void 调用」，
                          它**不会**变异非 void 的方法调用——而本项目的入参校验全是
                          `Objects.requireNonNull(x, "name")`，返回值被丢弃，于是在 `DEFAULTS` 下
                          这些校验连一个变异体都产不出来（`spec` 包 27 个节点的构造器校验长期
                          对 PIT 隐形）。加 `NON_VOID_METHOD_CALLS` 才能让「把校验删掉」变成一个
                          必须被用例杀死的变异体。
                          另加 `STRONGER`（在 `DEFAULTS` 之上再补空值返回、常量返回、增量、
                          数学算子、构造器调用等），因为 `spec`/`builder` 里大量逻辑是
                          「算出一个值」而不是「走一个分支」。
                        -->
                        <mutators>
                            <mutator>STRONGER</mutator>
                            <mutator>NON_VOID_METHOD_CALLS</mutator>
                        </mutators>
                        <!--
                          `-FRECORD`：关掉 PIT 默认开启的 `FRECORD` 过滤器。
                          它在 `pitest-entry` 里的自述是「Filters mutations in compiler generated record code」，
                          实测行为却是把**整个 record 类**的变异体全部丢弃——不是只丢编译器合成的
                          `equals`/`hashCode`/`toString`/访问器。后果：本项目 `core` 的 `spec` 包里
                          27 个节点类型全是 record，紧凑构造器里的入参校验（`requireNonNull`、
                          「空集合必须在 builder 层折成 Constant」）因此长期零变异——
                          46 个生产源文件只有 19 个产出过变异体，分数看着满分，实际整包没被度量。
                          关掉之后同一批用例的变异体从 242 涨到 857，其中 67 个当场暴露成
                          SURVIVED/NO_COVERAGE（见 `tools/equivalents/` 台账）。
                          代价是会自动生成 record 合成的 `equals`/`hashCode`/`toString` 变异体，
                          那些是语言生成代码，由下面的 `excludedMethods` 排掉。
                        -->
                        <features>
                            <param>-FRECORD</param>
                        </features>
                        <!--
                          排除与业务语义无关的合成方法：`equals`/`hashCode`/`toString` 对 record 是
                          编译器按字段逐一生成的，给它们写用例只能证明「JDK 的 record 实现是对的」；
                          `values`/`valueOf` 同理（enum 合成静态方法）。
                        -->
                        <excludedMethods>
                            <param>equals</param>
                            <param>hashCode</param>
                            <param>toString</param>
                            <param>values</param>
                            <param>valueOf</param>
                        </excludedMethods>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- 环境与依赖方向：JDK/Maven 版本 + 禁止反向依赖 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 格式化：check 绑定 validate，apply 手工执行 -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 静态检查：verify 阶段执行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 覆盖率：agent 全局挂，check 由各模块按需开启 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      发布 profile：`mvn -Ppublish deploy`。不激活时插件与属性都不参与构建。

      目标仓库是 Central Publisher Portal（旧的 OSSRH 已于 2025-06 关停），用
      org.sonatype.central:central-publishing-maven-plugin 0.12.0（2026-10 时点最新稳定版，
      Apache-2.0 开源）。extensions=true 时它在运行期替换 maven-deploy-plugin 的绑定，所以不需要
      distributionManagement；publishingServerId 对应 ~/.m2/settings.xml 里的 <server id="central">。

      为什么还要 flatten-maven-plugin：root aggregator 本身不发布，而子模块 POM 的 parent
      指向它，消费者会解析不到父 POM。flatten 在 process-resources 生成 .flattened-pom.xml：
      剥掉 parent、解析 ${project.version} 等变量、去掉 test 依赖与 build 段；ossrh 模式保留
      Central 必需的 url/licenses/developers/scm。该文件在模块根目录，已加入 .gitignore。

      发布集由根 properties 的开关决定：6 个对外模块在自己的 pom 里把 skipPublishing /
      source / javadoc / gpg / flatten 的 skip 覆盖成 false；其余模块靠默认 true 排除。
      central 插件只在根 pom 声明一次（extensions=true），子模块继承配置。
    -->
    <profiles>
        <profile>
            <id>publish</id>
            <build>
                <plugins>
                    <!-- 源码 jar：Central 要求每个 jar 产物都带 sources 与 javadoc -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <configuration>
                            <skipSource>${maven.source.skip}</skipSource>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- javadoc jar：中文注释会撞 doclint，统一 doclint=none（只关检查，failOnError
                         保持默认 true，真编译错误仍然红） -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <skip>${maven.javadoc.skip}</skip>
                            <release>${java.version}</release>
                            <doclint>none</doclint>
                            <encoding>${project.build.sourceEncoding}</encoding>
                            <docencoding>${project.build.sourceEncoding}</docencoding>
                            <charset>${project.build.sourceEncoding}</charset>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 签名：口令只从环境变量取（CI 由 secrets.GPG_PASSPHRASE 注入），pom 里不写凭据。
                         无 key 的本地验证：-Dgpg.skip=true -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <skip>${gpg.skip}</skip>
                            <passphrase>${env.MAVEN_GPG_PASSPHRASE}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 剥离 parent、解析变量的部署 POM 生成器 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>${flatten-maven-plugin.version}</version>
                        <configuration>
                            <skip>${flatten.skip}</skip>
                            <flattenMode>${flatten.mode}</flattenMode>
                            <updatePomFile>true</updatePomFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central Portal 上传：bundle 落在第一个（root）模块的 target/central-publishing/。
                         skipPublishing / skipUpload 是插件的 user property，这里用 central.publishing.*
                         桥接，方便命令行 -Dcentral.publishing.skipPublishing=true 做无凭证验证。 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <deploymentName>nextentity ${project.version}</deploymentName>
                            <skipPublishing>${central.publishing.skipPublishing}</skipPublishing>
                            <skipUpload>${central.publishing.skipUpload}</skipUpload>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
