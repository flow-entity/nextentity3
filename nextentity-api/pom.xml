<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextentity-api</artifactId>
    <name>nextentity-api</name>
    <description>公开 DSL：零三方依赖</description>

    <dependencies>
        <!-- api 零三方依赖：锁模式用自研 api.LockMode，不引入任何持久化/后端类型 -->
        <!--
          下面两个是 test 作用域，只为变异测试存在：api 的用例住在 core 的测试树
          （理由见 docs/DESIGN.md §5「api 值层断言的落点」），而 PIT 要在本模块里跑，
          就得让本模块的测试类路径上有 JUnit 5 与 AssertJ。test 作用域不进发布产物。
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 依赖方向门禁：api 必须零依赖 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-api-is-dependency-free</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>*:*:*:*:compile</exclude>
                                        <exclude>*:*:*:*:runtime</exclude>
                                        <exclude>*:*:*:*:provided</exclude>
                                        <exclude>*:*:*:*:system</exclude>
                                    </excludes>
                                    <message>api 的发布产物必须零三方依赖：compile / runtime / provided 一律下沉到 core 或后端模块。只有 test 作用域可用——它不进 jar，只服务本模块的变异测试（见 docs/DESIGN.md §5）</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- API 兼容门禁：-Papi-compat -Djapicmp.oldVersion=<上一发布版>
                 3.0.0 起基线 artifact 是 nextentity-api（api 独立成模块发布）；
                 对照 2.2.3 的历史报告要显式传 -Djapicmp.oldArtifactId=nextentity-core，
                 因为 2.2.3 没发布过 nextentity-api，io.github.nextentity.api.* 的类在
                 nextentity-core-2.2.3.jar 里。

                 默认基线是「上一发布版」，所以本门禁只在项目版本 > 基线时才有意义：
                 pom 版本与基线相同时（刚发版的 HEAD），japicmp 会拿本模块 target 里的
                 jar 与自身比较，然后报 "Versions of archives indicate no API changes but
                 found API changes"。发下一版前先 bump 到下一个开发版（如 3.2.0-SNAPSHOT）再跑。 -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <!-- 只有显式 -Papi-compat 才跑；普通 verify 不为一次报告多花十几秒 -->
                    <skip>${japicmp.skip}</skip>
                    <oldVersion>
                        <dependency>
                            <groupId>io.github.flow-entity</groupId>
                            <artifactId>${japicmp.oldArtifactId}</artifactId>
                            <version>${japicmp.oldVersion}</version>
                        </dependency>
                    </oldVersion>
                    <newVersion>
                        <file>
                            <path>${project.build.directory}/${project.build.finalName}.jar</path>
                        </file>
                    </newVersion>
                    <parameter>
                        <includes>
                            <include>io.github.nextentity.api.*</include>
                        </includes>
                        <onlyModified>false</onlyModified>
                        <breakBuildBasedOnSemanticVersioning>true</breakBuildBasedOnSemanticVersioning>
                        <ignoreMissingClasses>false</ignoreMissingClasses>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              变异测试：api 自己的用例就在本模块（`src/test/java`），所以这条门禁是自足的，
              不挂别的模块的产物。不绑生命周期，只在显式执行时跑：
              `mvn -pl nextentity-api pitest:mutationCoverage`。
              阈值 95：等价变异杀不死，新代码磨合期也会短暂掉分，阈值只用来挡真回退。
              api 的「值 → Spec 节点」翻译证据不在这里，在 core 的 ApiOperatorAssemblyTest。
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>io.github.nextentity.api.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.github.nextentity.api.*</param>
                    </targetTests>
                    <failWhenNoMutations>true</failWhenNoMutations>
                    <mutationThreshold>95</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>api-compat</id>
            <properties>
                <japicmp.skip>false</japicmp.skip>
            </properties>
        </profile>
    </profiles>

    <properties>
        <japicmp.skip>true</japicmp.skip>
        <!-- 基线 = 上一发布版（3.0.0 已发 Central，api 有独立 artifact）。
             对照 2.2.3 需显式 -Djapicmp.oldArtifactId=nextentity-core。 -->
        <japicmp.oldVersion>3.0.0</japicmp.oldVersion>
        <japicmp.oldArtifactId>nextentity-api</japicmp.oldArtifactId>
        <!-- 发布集：本模块发到 Central，覆盖根 pom 的默认 true，仅 -Ppublish 生效 -->
        <central.publishing.skipPublishing>false</central.publishing.skipPublishing>
        <maven.source.skip>false</maven.source.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <gpg.skip>false</gpg.skip>
        <flatten.skip>false</flatten.skip>
    </properties>
</project>



