<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flow-entity</groupId>
        <artifactId>nextentity</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextentity-api</artifactId>
    <name>nextentity-api</name>
    <description>公开 DSL：零三方依赖</description>

    <dependencies>
        <!--
          唯一登记例外：api 里只有 LockStep.lock(jakarta.persistence.LockModeType) 兼容重载用到它。
          理由：point-mall 有 3 处存量调用点（OrgShippingService:522、LogisticsOrderRepository:26、
          WorkflowParallelRepository:29），换成自研枚举会破 D3（改消费方）与 D6（japicmp）。
          provided：不传递给任何下游，core / core.spec 完全不接触 jakarta。
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 依赖方向门禁：api 必须零依赖（仅放行上面登记的 jakarta.persistence-api） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-api-is-dependency-free</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>*:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>jakarta.persistence:jakarta.persistence-api</include>
                                    </includes>
                                    <message>api 模块必须零三方依赖：任何依赖都应下沉到 core 或后端模块</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- API 兼容门禁：-Papi-compat -Djapicmp.oldVersion=2.2.3
                 基线必须是 nextentity-core：2.2.3 没有发布过 nextentity-api，
                 io.github.nextentity.api.* 的类在 nextentity-core-2.2.3.jar 里。 -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>io.github.flow-entity</groupId>
                            <artifactId>nextentity-core</artifactId>
                            <version>${japicmp.oldVersion}</version>
                        </dependency>
                    </oldVersion>
                    <newVersion>
                        <file>
                            <path>${project.build.directory}/${project.build.finalName}.jar</path>
                        </file>
                    </newVersion>
                    <parameter>
                        <includes>
                            <include>io.github.nextentity.api.*</include>
                        </includes>
                        <onlyModified>false</onlyModified>
                        <breakBuildBasedOnSemanticVersioning>true</breakBuildBasedOnSemanticVersioning>
                        <ignoreMissingClasses>false</ignoreMissingClasses>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>api-compat</id>
            <properties>
                <japicmp.skip>false</japicmp.skip>
            </properties>
        </profile>
    </profiles>

    <properties>
        <japicmp.skip>true</japicmp.skip>
        <japicmp.oldVersion>2.2.3</japicmp.oldVersion>
    </properties>
</project>



